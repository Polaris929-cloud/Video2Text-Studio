# 统一换行：仓库内文本文件统一用 LF，避免 Windows/macOS 协作时整文件 diff
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.wasm binary
*.onnx binary

# 让 GitHub 正确识别语言统计
*.ts linguist-language=TypeScript
*.tsx linguist-language=TypeScript

# 构建产物与依赖不进语言统计
dist/** linguist-generated=true
package-lock.json linguist-generated=true -diff
